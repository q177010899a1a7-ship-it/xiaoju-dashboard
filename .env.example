# 小居数据监控台 - 环境变量配置示例

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 数据刷新间隔（秒），默认1800（30分钟）
REFRESH_INTERVAL=1800

# 飞书 Webhook（可选，用于推送消息到飞书）
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 企业微信 Webhook（可选，用于推送消息到企业微信群）
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# OpenAI API Key（可选，用于AI生成报告）
# 如果不配置，系统将使用模板生成规则报告
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
